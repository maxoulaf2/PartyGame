<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- wwwroot is produced by Vite, which already fingerprints assets. The SDK pipeline would only
         snapshot that folder at build time, and overlay the snapshot on any other web root in Development. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PartyGame.Contracts\PartyGame.Contracts.csproj" />
    <ProjectReference Include="..\PartyGame.Engine\PartyGame.Engine.csproj" />
    <ProjectReference Include="..\PartyGame.Content\PartyGame.Content.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PartyGame.Server.Tests" />
    <InternalsVisibleTo Include="PartyGame.Bots.Tests" />
  </ItemGroup>

</Project>
