# Normalize line endings: LF in the repository and in the working copy, on every OS
* text=auto eol=lf

# Windows-only scripts need CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files: never diffed or normalized
*.mp3   binary
*.ogg   binary
*.wav   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary
